# ---- Core ----
POSTGRES_PASSWORD=viljaops
JWT_SECRET=generate-with-openssl-rand-hex-32

# "production" turns on a startup safety check that refuses to boot with any
# default secret still in place, and makes the GitHub webhook fail closed
# (reject unsigned events) instead of open if GITHUB_WEBHOOK_SECRET is unset.
# Leave this as "development" for local/demo use.
ENVIRONMENT=development
# Comma-separated origins the dashboard is served from, e.g.
# https://ops.vnrvjiet.in — required (non-empty) once ENVIRONMENT=production.
# Empty/unset means "allow any origin", which is fine for local development
# only.
CORS_ALLOWED_ORIGINS=

# ---- Self-hosted LLM (Ollama or vLLM, both OpenAI-compatible) ----
# Ollama:
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5-coder:14b
LLM_API_KEY=ollama
# vLLM example:
# LLM_BASE_URL=http://gpu-node.internal:8000/v1
# LLM_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct

# ---- Embeddings for the incident RAG index ----
EMBED_BASE_URL=http://ollama:11434
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ---- GitHub ----
GITHUB_ORG=your-org
GITHUB_TOKEN=ghp_xxx              # repo + actions:read on the org
GITHUB_WEBHOOK_SECRET=random-string

# ---- Bootstrap admin ----
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=DUMMY_PASSWORD_DO_NOT_USE

# ---- Safety ----
# false = every fix needs a human click. Leave false on shared infra.
AUTO_REMEDIATION=false
